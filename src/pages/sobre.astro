---
import Site from '../layouts/Site.astro';
import JsonLd from '../components/JsonLd.astro';
import organization from '../data/organization.json';
import { breadcrumb, webPage, orgRef, ORG_ID, SITE } from '../lib/schema.js';
import { VIEWS } from '../data/views.js';

const { title, description } = VIEWS.about;

// Person completos ficam aqui, e nao em organization.json, porque e esta a
// pagina que fala deles: e o sinal de E-E-A-T que o Google le.
const people = [
  {
    '@type': 'Person',
    '@id': `${SITE}/sobre/#luis`,
    name: 'Luis',
    jobTitle: 'Desenvolvedor & Co-fundador',
    worksFor: orgRef,
    image: `${SITE}/assets/images/team/luis.jpg`,
    knowsAbout: ['HTML & CSS', 'JavaScript', 'UI Design', 'Performance Web', 'SEO Técnico'],
  },
  {
    '@type': 'Person',
    '@id': `${SITE}/sobre/#joao`,
    name: 'João',
    jobTitle: 'Administrador & Co-fundador',
    worksFor: orgRef,
    image: `${SITE}/assets/images/team/joao.jpg`,
    knowsAbout: ['Gestão de Projetos', 'Relacionamento', 'Estratégia Digital', 'Domínios & Hosting'],
  },
];

const schema = [
  { ...organization, '@id': ORG_ID, founder: people.map((p) => ({ '@id': p['@id'] })) },
  ...people,
  webPage('AboutPage', { path: '/sobre/', name: title, description }),
  breadcrumb([{ label: 'Sobre', href: '/sobre/' }]),
];

---

<Site view="about">
  <JsonLd slot="head" nodes={schema} />
</Site>
